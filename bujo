#!/usr/bin/env python3
"""bujo — bullet-journal todos living in Obsidian daily notes.

Owns exactly one section of a daily note (default "## Todo") and nothing else.
Reads only the lines between that heading and the next "## " or EOF, so
frontmatter, journal prompts and stray checkboxes elsewhere are invisible.

Markdown is the database. This is the only thing that writes it.
"""

import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
from datetime import date, datetime, timedelta
from pathlib import Path

try:
    import tomllib
except ModuleNotFoundError:
    sys.exit("bujo needs Python 3.11+ (tomllib)")

CONFIG_PATH = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "bujo" / "config.toml"

DEFAULT_TEMPLATE = "---\ntags:\n  - journal/daily\n---\n# {{date:YYYY-MM-DD}}\n\n## Todo\n"

# vault and path are deliberately empty: they are the two settings only the
# user can know, and a wrong guess that resolves is worse than a blank that
# says so. Everything else here is a real default.
DEFAULTS = {
    "vault": "",
    "path": "",
    "section": "## Todo",
    "log_section": "## Log",
    "icon": "\U000f0132",
    "urgent_days": 7,
    "template_file": "",
    "template": DEFAULT_TEMPLATE,
}

CONFIG_HEADER = (
    "# bujo — see README. Every {{date:FORMAT}} uses moment-style tokens\n"
    "# (YYYY MMMM MMM MM M DD D dddd ddd) rendered from a fixed English\n"
    "# table, never the system locale.\n"
    "#\n"
    "# `bujo config set <key> <value>` rewrites this file, and the settings\n"
    "# page in the bar goes through that rather than editing TOML itself."
)

CONFIG_NOTES_VAULT = (
    "# Your Obsidian vault, and where daily notes sit inside it. Nothing works\n"
    "# until both are set — `bujo config check` says what is missing."
)

# Comments worth keeping in the written file, keyed by the line they precede.
CONFIG_NOTES = {
    "vault": CONFIG_NOTES_VAULT,
    "template_file": "# Rendered once when a note has to be created, never read again.\n"
                     "# template_file — vault-relative — overrides the inline template below.",
}


# The capture prompt defaults to 300px, which is about forty characters — a
# todo is a sentence, not a filename. The menu caps this to the screen, so a
# generous number degrades rather than overflows.
MENU_WIDTH = "560"

OPEN, DONE, MIGRATED, DROPPED = " ", "x", ">", "-"
TASK_RE = re.compile(r"^(?P<indent>\s*)- \[(?P<status>.)\] (?P<text>.*)$")
DATE_HOLE_RE = re.compile(r"\{\{date:([^}]*)\}\}")
DONE_STAMP_RE = re.compile(r"\s*✅\s*\d{4}-\d{2}-\d{2}\s*$")
MOVED_TO_RE = re.compile(r"\s*→\s*\[\[[^\]]+\]\]\s*$")
MOVED_TARGET_RE = re.compile(r"→\s*\[\[(\d{4}-\d{2}-\d{2})\]\]")
# Any bullet in the log section is a note, checkbox-shaped ones included — it
# is what the file says, and the log is not ours to tidy.
NOTE_RE = re.compile(r"^(?P<indent>\s*)- (?P<text>.*)$")

MONTHS = ["January", "February", "March", "April", "May", "June",
          "July", "August", "September", "October", "November", "December"]
WEEKDAYS = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]

# Longest token first — "MM" must not eat the front of "MMMM".
TOKENS = [
    ("YYYY", lambda d: "%04d" % d.year, r"\d{4}", "Y"),
    ("MMMM", lambda d: MONTHS[d.month - 1], r"[A-Za-z]+", "MN"),
    ("MMM", lambda d: MONTHS[d.month - 1][:3], r"[A-Za-z]{3}", "MA"),
    ("MM", lambda d: "%02d" % d.month, r"\d{2}", "m"),
    ("dddd", lambda d: WEEKDAYS[d.weekday()], r"[A-Za-z]+", None),
    ("ddd", lambda d: WEEKDAYS[d.weekday()][:3], r"[A-Za-z]{3}", None),
    ("DD", lambda d: "%02d" % d.day, r"\d{2}", "d"),
    ("D", lambda d: str(d.day), r"\d{1,2}", "d"),
    ("M", lambda d: str(d.month), r"\d{1,2}", "m"),
]


# --------------------------------------------------------------------- config

def read_config():
    """Merged config, unexpanded and unvalidated.

    The settings page has to be able to show a vault that is not there, so the
    check that stops every other command lives in load_config, not here.
    """
    cfg = dict(DEFAULTS)
    if CONFIG_PATH.exists():
        with CONFIG_PATH.open("rb") as fh:
            cfg.update(tomllib.load(fh))
    else:
        write_config(dict(DEFAULTS))
    return cfg


def load_config():
    cfg = read_config()
    for name, err in (("vault", vault_error(cfg["vault"])), ("path", path_error(cfg["path"]))):
        if err:
            sys.exit("bujo: %s %s\n"
                     "      Open the bar panel and press `s`, or edit %s" % (name, err, CONFIG_PATH))
    cfg["vault"] = vault_path(cfg["vault"])
    return cfg


def toml_value(v):
    """Enough TOML to write our own settings back. Anything with a newline
    becomes a multi-line string: a template folded onto one line with \\n in
    it is a file nobody can read, and this one is meant to be read."""
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, int):
        return str(v)
    s = str(v)
    if "\n" not in s:
        return json.dumps(s, ensure_ascii=False)
    body = s.replace("\\", "\\\\").replace('"""', '""\\"')
    if body.endswith('"'):
        body = body[:-1] + '\\"'
    return '"""\\\n%s"""' % body


def write_config(cfg):
    """The one writer. The panel asks for a change and this renders the file;
    a second TOML writer over in QML is a second set of escaping bugs."""
    out = [CONFIG_HEADER]
    for i, k in enumerate(list(DEFAULTS) + [k for k in cfg if k not in DEFAULTS]):
        line = "%s = %s" % (k, toml_value(cfg[k]))
        # A blank line only where one earns its keep: under the header, before
        # a comment, and around a value that spans lines of its own.
        if i == 0 or k in CONFIG_NOTES or "\n" in line:
            out.append("")
        if k in CONFIG_NOTES:
            out.append(CONFIG_NOTES[k])
        out.append(line)
    write_lines(CONFIG_PATH, out)


# ------------------------------------------------------------------- the rules
#
# Every rule the settings page shows is decided here, once. QML reads the
# verdicts and renders them; it re-derives nothing, so there is no second
# opinion about what a valid vault, path or template is.

def vault_path(value):
    return Path(str(value).strip()).expanduser()


def vault_error(value):
    """Unset is its own answer. Path("") expands to ".", which is a perfectly
    real directory — left unguarded, an empty vault passes is_dir() and bujo
    quietly writes todos into whatever directory it happened to run in."""
    if not str(value).strip():
        return "not set — point it at your Obsidian vault"
    p = vault_path(value)
    return "" if p.is_dir() else "not found: %s" % p


def path_error(value):
    if not str(value).strip():
        return "not set — the pattern your daily notes are named by"
    return ""


def templater_error(text):
    """Templater runs inside Obsidian. We only ever expand {{date:...}}."""
    return "uses Templater <% %> syntax, which only Obsidian can render" if "<%" in text else ""


def heading_error(value):
    """The section contract reads to the next `## `, so the heading has to be
    one — `# Todo` would swallow every section below it."""
    return "" if value.startswith("## ") and value.strip() == value else \
        "must be a level-2 heading with a name, like ## Todo"


def effective_template(cfg, vault):
    """(text, source, error). template_file wins whenever it is set — which is
    exactly the shadowing the settings page has to make visible."""
    name = str(cfg.get("template_file", "")).strip()
    if not name:
        return str(cfg["template"]), "inline", ""
    src = vault / name
    if not src.is_file():
        return "", "file", "not found in the vault: %s" % src
    try:
        return src.read_text(encoding="utf-8"), "file", ""
    except OSError as e:
        return "", "file", "cannot be read: %s" % e.strerror


def check_config(cfg):
    """One verdict per settable field: {ok, note}, plus the resolved path for
    today and which template is actually in force."""
    vault = vault_path(cfg["vault"])
    today = date.today()

    unset = path_error(cfg["path"])
    rel = "" if unset else render(str(cfg["path"]), today)
    matcher, kinds = path_matcher(cfg)
    reads_back = not unset and path_to_date(matcher, kinds, rel) == today

    text, source, file_err = effective_template(cfg, vault)
    inline_err = templater_error(str(cfg["template"]))
    if not file_err and source == "file":
        file_err = templater_error(text)

    section_err = heading_error(str(cfg["section"])) or heading_error(str(cfg["log_section"]))
    if not section_err and str(cfg["section"]).strip() == str(cfg["log_section"]).strip():
        section_err = "the todo and log sections must differ"

    verr = vault_error(cfg["vault"])
    fields = {
        "vault": {"ok": not verr, "note": verr or str(vault)},
        "path": {"ok": reads_back, "preview": rel,
                 "note": unset if unset else
                         "" if reads_back else
                         "no date reads back out of this — every note would look undated"},
        "section": {"ok": not heading_error(str(cfg["section"])) and not section_err,
                    "note": section_err},
        "log_section": {"ok": not heading_error(str(cfg["log_section"])) and not section_err,
                        "note": section_err},
        "template_file": {"ok": not file_err,
                          "note": file_err or ("in use — overrides the template below"
                                               if source == "file" else "")},
        "template": {"ok": not inline_err,
                     "note": inline_err or ("overridden by the template file above"
                                            if source == "file" else "")},
    }
    return {"ok": all(f["ok"] for f in fields.values()), "source": source, "fields": fields}


# ----------------------------------------------------------------- date tokens

def fmt_date(fmt, d):
    out, i = [], 0
    while i < len(fmt):
        for token, render, _rx, _kind in TOKENS:
            if fmt.startswith(token, i):
                out.append(render(d))
                i += len(token)
                break
        else:
            out.append(fmt[i])
            i += 1
    return "".join(out)


def render(text, d):
    return DATE_HOLE_RE.sub(lambda m: fmt_date(m.group(1), d), text)


def parse_when(when, today=None):
    """Delegate natural-language dates to GNU date. No parser of our own."""
    today = today or date.today()
    if not when:
        return today
    try:
        out = subprocess.run(["date", "-d", when, "+%Y-%m-%d"],
                             capture_output=True, text=True, check=True,
                             env={**os.environ, "LC_TIME": "C"})
    except (subprocess.CalledProcessError, FileNotFoundError):
        return None
    return date.fromisoformat(out.stdout.strip())


# ------------------------------------------------------------------- note path

def note_path(cfg, d):
    return cfg["vault"] / render(cfg["path"], d)


def journal_root(cfg):
    """Static prefix of the path pattern — the subtree worth scanning."""
    head = cfg["path"].split("{{", 1)[0]
    return cfg["vault"] / Path(head).parent if "/" in head else cfg["vault"]


def path_matcher(cfg):
    """Turn the path pattern into a regex that reads a date back out of a path.

    This is what makes the tool portable: one pattern setting covers core
    Daily notes, Periodic Notes and journals users alike, and month names are
    matched from our own English table rather than the system locale.
    """
    parts, kinds, n = [], [], 0
    pos = 0
    for m in DATE_HOLE_RE.finditer(cfg["path"]):
        parts.append(re.escape(cfg["path"][pos:m.start()]))
        fmt, i = m.group(1), 0
        while i < len(fmt):
            for token, _render, rx, kind in TOKENS:
                if fmt.startswith(token, i):
                    if kind:
                        n += 1
                        name = "g%d" % n
                        parts.append("(?P<%s>%s)" % (name, rx))
                        kinds.append((name, kind))
                    else:
                        parts.append("(?:%s)" % rx)
                    i += len(token)
                    break
            else:
                parts.append(re.escape(fmt[i]))
                i += 1
        pos = m.end()
    parts.append(re.escape(cfg["path"][pos:]))
    return re.compile("^" + "".join(parts) + "$"), kinds


def path_to_date(matcher, kinds, relpath):
    m = matcher.match(relpath)
    if not m:
        return None
    # Last group wins, so the filename (deepest in the path) beats a folder
    # that disagrees with it — and an unreadable month-name folder falls back
    # to the numeric month rather than dropping the note off the radar.
    year = month = day = None
    for name, kind in kinds:
        v = m.group(name)
        if kind == "Y":
            year = int(v)
        elif kind == "m":
            month = int(v)
        elif kind in ("MN", "MA"):
            cut = 3 if kind == "MA" else None
            found = next((i + 1 for i, nm in enumerate(MONTHS) if nm[:cut].lower() == v.lower()), None)
            if found:
                month = found
        elif kind == "d":
            day = int(v)
    if not (year and month and day):
        return None
    try:
        return date(year, month, day)
    except ValueError:
        return None


# ------------------------------------------------------------ the one section

def read_lines(path):
    return path.read_text(encoding="utf-8").splitlines() if path.exists() else []


def write_lines(path, lines):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=".bujo-", suffix=".md")
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write("\n".join(lines) + "\n")
    os.replace(tmp, path)


def section_bounds(lines, heading):
    """(first, last) line indices of the section body, or None if absent."""
    start = next((i for i, l in enumerate(lines) if l.strip() == heading), None)
    if start is None:
        return None
    end = len(lines)
    for j in range(start + 1, len(lines)):
        if lines[j].startswith("## "):
            end = j
            break
    return start + 1, end


def ensure_note(cfg, d):
    """Create the note from the user's template if it isn't there yet."""
    path = note_path(cfg, d)
    if path.exists():
        return path
    tpl, _source, err = effective_template(cfg, cfg["vault"])
    if err:
        sys.exit("bujo: template_file %s" % err)
    err = templater_error(tpl)
    if err:
        sys.exit("bujo: template %s.\n"
                 "      Point template_file at a {{date:...}} template, or use the inline one." % err)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(render(tpl, d), encoding="utf-8")
    return path


def ensure_section(lines, heading):
    """Append the owned section at the bottom if absent. Never touches the rest."""
    if section_bounds(lines, heading) is None:
        while lines and not lines[-1].strip():
            lines.pop()
        if lines:
            lines.append("")
        lines.append(heading)
    return section_bounds(lines, heading)


def append_to_section(cfg, d, heading, line):
    """Insert one line at the end of a section, creating the note and the
    section if needed. Everything bujo adds goes through here."""
    path = ensure_note(cfg, d)
    lines = read_lines(path)
    first, last = ensure_section(lines, heading)
    at = last
    while at > first and not lines[at - 1].strip():
        at -= 1
    lines.insert(at, line)
    write_lines(path, lines)
    return path


def ref_for(cfg, path, lineno, line):
    rel = str(path.relative_to(cfg["vault"]))
    return "%s:%d:%s" % (rel, lineno, hashlib.sha1(line.encode("utf-8")).hexdigest()[:8])


def resolve_ref(cfg, ref):
    """Verify before acting — an Obsidian edit shifts lines under a live panel."""
    try:
        rel, lineno, digest = ref.rsplit(":", 2)
        lineno = int(lineno)
    except ValueError:
        sys.exit("bujo: malformed ref %r" % ref)
    path = cfg["vault"] / rel
    lines = read_lines(path)
    if lineno >= len(lines):
        sys.exit("bujo: that task moved — rescan and try again")
    if hashlib.sha1(lines[lineno].encode("utf-8")).hexdigest()[:8] != digest:
        sys.exit("bujo: that task changed under us — rescan and try again")
    return path, lines, lineno


# ------------------------------------------------------------------- the tasks

def clean_text(text):
    return MOVED_TO_RE.sub("", DONE_STAMP_RE.sub("", text)).strip()


def tasks_in(cfg, path, day):
    bounds = section_bounds(read_lines(path), cfg["section"])
    if bounds is None:
        return []
    lines = read_lines(path)
    out = []
    for i in range(bounds[0], bounds[1]):
        m = TASK_RE.match(lines[i])
        if m:
            out.append({
                "day": day.isoformat(),
                "status": m.group("status"),
                "text": m.group("text"),
                "clean": clean_text(m.group("text")),
                "indent": len(m.group("indent")),
                "ref": ref_for(cfg, path, i, lines[i]),
            })
    return out


def notes_in(cfg, path, day):
    """The log section's bullets. No status — a note records what happened and
    there is nothing about one to decide — but a ref, because `edit` writes
    here and a write has to be verified against the line it thinks it found."""
    lines = read_lines(path)
    bounds = section_bounds(lines, cfg["log_section"])
    if bounds is None:
        return []
    out = []
    for i in range(bounds[0], bounds[1]):
        m = NOTE_RE.match(lines[i])
        if m and m.group("text").strip():
            out.append({"day": day.isoformat(), "text": m.group("text").strip(),
                        "ref": ref_for(cfg, path, i, lines[i])})
    return out


def walk_days(cfg, since, until):
    """Every day in range that has a note, counted in ONE pass over the tree.

    The calendar needs a month at a time and a process per day is not a
    calendar, it is thirty processes.
    """
    matcher, kinds = path_matcher(cfg)
    root = journal_root(cfg)
    out = {}
    if root.exists():
        for p in root.rglob("*.md"):
            d = path_to_date(matcher, kinds, str(p.relative_to(cfg["vault"])))
            if d is None or d < since or d > until:
                continue
            tasks = tasks_in(cfg, p, d)
            out[d] = {
                "day": d.isoformat(),
                "todos": len(tasks),
                "open": len([t for t in tasks if t["status"] == OPEN]),
                "done": len([t for t in tasks if t["status"] == DONE]),
                "notes": len(notes_in(cfg, p, d)),
            }
    return [out[d] for d in sorted(out)]


def month_range(month):
    """'2026-09' -> (first, last). Its own function because December has to
    roll the year, and getting that wrong loses a month of history silently."""
    try:
        year, mon = (int(x) for x in str(month).split("-"))
        first = date(year, mon, 1)
    except ValueError:
        return None, None
    last = date(year + (mon == 12), (mon % 12) + 1, 1) - timedelta(days=1)
    return first, last


def scan(cfg, since=None, until=None):
    """Every daily note in range, oldest first. Dangling is unbounded by design."""
    matcher, kinds = path_matcher(cfg)
    root = journal_root(cfg)
    found = []
    if root.exists():
        for p in root.rglob("*.md"):
            d = path_to_date(matcher, kinds, str(p.relative_to(cfg["vault"])))
            if d is None:
                continue
            if since and d < since:
                continue
            if until and d > until:
                continue
            found.append((d, p))
    found.sort()
    return [t for d, p in found for t in tasks_in(cfg, p, d)]


def dangling(cfg, today=None):
    today = today or date.today()
    return [t for t in scan(cfg, until=today - timedelta(days=1)) if t["status"] == OPEN]


def today_tasks(cfg, today=None):
    today = today or date.today()
    p = note_path(cfg, today)
    return tasks_in(cfg, p, today) if p.exists() else []


# --------------------------------------------------------------------- actions

def cmd_add(cfg, args):
    d = parse_when(args.when)
    if d is None:
        sys.exit("bujo: could not read a date from %r" % args.when)
    append_to_section(cfg, d, cfg["section"], "- [ ] %s" % args.text)
    notify_shell()
    print("%s  %s" % (fmt_date("ddd D MMM", d), args.text))


def cmd_add_interactive(cfg, args):
    text = run_or_none(["omarchy-menu-input", "Todo", "--width", MENU_WIDTH])
    if not text:
        return
    text, d = split_trailing_date(text.strip())
    if not text:
        return
    append_to_section(cfg, d, cfg["section"], "- [ ] %s" % text)
    notify_shell()
    when = "today" if d == date.today() else fmt_date("ddd D MMM", d)
    run_or_none(["omarchy-notification-send", "Todo → %s" % when, text])


def split_trailing_date(text, today=None):
    """"call the accountant friday" -> ("call the accountant", <Fri>).

    Only a suffix that resolves to today or later counts, which is what keeps
    "pay the march invoice" from being filed under March.
    """
    today = today or date.today()
    words = text.split()
    for n in (3, 2, 1):
        if len(words) <= n:
            continue
        d = parse_when(" ".join(words[-n:]), today)
        if d and d >= today:
            return " ".join(words[:-n]), d
    return text, today


def cmd_done(cfg, args):
    """Toggle. Pressing c twice is how you undo a mis-hit, and clean_text
    drops the ✅ stamp on the way back out."""
    path, lines, i = resolve_ref(cfg, args.ref)
    m = TASK_RE.match(lines[i])
    if not m:
        sys.exit("bujo: not a task line")
    text = clean_text(m.group("text"))
    if m.group("status") == DONE:
        lines[i] = "%s- [ ] %s" % (m.group("indent"), text)
        target, cleared = None, False
    else:
        # Ticking a task you had deferred means it is finished, not that it is
        # still waiting on the day you sent it to.
        i, target, cleared = settle_migration(cfg, path, lines, i, m)
        lines[i] = "%s- [x] %s ✅ %s" % (m.group("indent"), text, date.today().isoformat())
    write_lines(path, lines)
    notify_shell()
    print(lines[i].strip())
    if cleared:
        print("cleared the copy on %s" % fmt_date("ddd D MMM", target))


def cmd_drop(cfg, args):
    path, lines, i = resolve_ref(cfg, args.ref)
    m = TASK_RE.match(lines[i])
    if not m:
        sys.exit("bujo: not a task line")
    status = OPEN if m.group("status") == DROPPED else DROPPED
    # Same rule as done: dropping a migrated task settles it at the target too.
    i, target, cleared = settle_migration(cfg, path, lines, i, m)
    lines[i] = "%s- [%s] %s" % (m.group("indent"), status, clean_text(m.group("text")))
    write_lines(path, lines)
    notify_shell()
    print(lines[i].strip())
    if cleared:
        print("cleared the copy on %s" % fmt_date("ddd D MMM", target))


def remove_open_copy(lines, heading, text, skip=-1):
    """Delete the first still-open task matching `text`. Returns its index, or
    -1 when there is nothing safe to remove — a copy already completed or
    edited at the target is somebody's work, not ours to throw away."""
    bounds = section_bounds(lines, heading)
    if bounds is None:
        return -1
    for j in range(bounds[0], bounds[1]):
        if j == skip:
            continue
        m = TASK_RE.match(lines[j])
        if m and m.group("status") == OPEN and clean_text(m.group("text")) == text:
            del lines[j]
            return j
    return -1


def migration_target(text):
    found = MOVED_TARGET_RE.search(text)
    return date.fromisoformat(found.group(1)) if found else None


def clear_copy_at_target(cfg, path, lines, i, text, target):
    """Drop the still-open copy a migration left at its target.

    Returns (index, cleared) — deleting a line above the one we are working on
    shifts it, and the caller is about to rewrite that line by index.

    Settling a task settles it everywhere: whether it was done, dropped or
    taken back, the copy waiting at the target is work that no longer needs
    doing. One already completed or edited there is somebody else's work and
    is left alone, which is remove_open_copy's rule, not ours.
    """
    tpath = note_path(cfg, target)
    if tpath == path:
        removed = remove_open_copy(lines, cfg["section"], text, skip=i)
        if 0 <= removed < i:
            i -= 1
        return i, removed >= 0
    if tpath.exists():
        tlines = read_lines(tpath)
        removed = remove_open_copy(tlines, cfg["section"], text)
        if removed >= 0:
            write_lines(tpath, tlines)
            return i, True
    return i, False


def settle_migration(cfg, path, lines, i, m):
    """(index, target, cleared) for a line that may record a migration."""
    if m.group("status") != MIGRATED:
        return i, None, False
    target = migration_target(m.group("text"))
    if target is None:
        return i, None, False
    i, cleared = clear_copy_at_target(cfg, path, lines, i, clean_text(m.group("text")), target)
    return i, target, cleared


def undo_move(cfg, path, lines, i, m):
    text = clean_text(m.group("text"))
    target = migration_target(m.group("text"))
    if target is None:
        sys.exit("bujo: that line records no migration target")
    i, removed = clear_copy_at_target(cfg, path, lines, i, text, target)

    lines[i] = "%s- [ ] %s" % (m.group("indent"), text)
    write_lines(path, lines)
    notify_shell()
    if removed:
        print("%s ← back from %s" % (text, fmt_date("ddd D MMM", target)))
    else:
        print("%s reopened — the copy on %s was already worked on, left alone"
              % (text, fmt_date("ddd D MMM", target)))


def cmd_move(cfg, args):
    path, lines, i = resolve_ref(cfg, args.ref)
    m = TASK_RE.match(lines[i])
    if not m:
        sys.exit("bujo: not a task line")

    # m on an already-migrated task takes it back rather than asking where to
    # send it again.
    if m.group("status") == MIGRATED and not args.when:
        return undo_move(cfg, path, lines, i, m)
    if not args.when:
        sys.exit("bujo: move needs a day")

    target = parse_when(args.when)
    if target is None:
        sys.exit("bujo: could not read a date from %r" % args.when)
    text = clean_text(m.group("text"))
    stamp = fmt_date("YYYY-MM-DD", target)

    # The origin day keeps the record. Nothing ever moves silently.
    lines[i] = "%s- [>] %s → [[%s]]" % (m.group("indent"), text, stamp)
    write_lines(path, lines)

    append_to_section(cfg, target, cfg["section"], "%s- [ ] %s" % (m.group("indent"), text))
    notify_shell()
    print("%s → %s" % (text, fmt_date("ddd D MMM", target)))


def cmd_note(cfg, args):
    """A plain "-" bullet into the day's log. No status, nothing to decide —
    that is the whole difference between a note and a todo."""
    append_to_section(cfg, date.today(), cfg["log_section"], "- %s" % args.text)
    print(args.text)


def cmd_note_interactive(cfg, args):
    # No trailing-date parsing here: a note records what happened, and what
    # happened happened today.
    text = run_or_none(["omarchy-menu-input", "Note", "--width", MENU_WIDTH])
    if not text or not text.strip():
        return
    append_to_section(cfg, date.today(), cfg["log_section"], "- %s" % text.strip())
    run_or_none(["omarchy-notification-send", "Noted", text.strip()])


def cmd_edit(cfg, args):
    """Rewrite one line's words, and only its words.

    One verb for a todo and a note alike, and the section says which is which.
    The status box, the ✅ stamp and the → migration link are what a line
    records about itself rather than what it says, and they survive the
    rewrite untouched — as does whatever a note's bullet happens to hold, so
    what the panel showed is what comes back.

    Editing a migrated task does break the text tying it to the copy at its
    target — which is already the answer the migration verbs give: a copy that
    no longer matches is somebody's work, and is left alone rather than
    thrown away.
    """
    text = args.text.strip()
    if not text:
        sys.exit("bujo: edit needs some text")
    path, lines, i = resolve_ref(cfg, args.ref)
    # Which section the line sits in is what it is — the same contract every
    # reader here works by. Reading the line's own shape instead would take a
    # checkbox hand-typed into the log for a task, and write the box back in
    # front of the text the panel had already shown the box in.
    log = section_bounds(lines, cfg["log_section"])
    if log and log[0] <= i < log[1]:
        m = NOTE_RE.match(lines[i])
        if not m:
            sys.exit("bujo: not a note")
        lines[i] = "%s- %s" % (m.group("indent"), text)
    else:
        m = TASK_RE.match(lines[i])
        if not m:
            sys.exit("bujo: not a task")
        kept = DONE_STAMP_RE.search(m.group("text")) or MOVED_TO_RE.search(m.group("text"))
        lines[i] = "%s- [%s] %s%s" % (m.group("indent"), m.group("status"), text,
                                      " " + kept.group(0).strip() if kept else "")
    write_lines(path, lines)
    notify_shell()
    print(lines[i].strip())


def cmd_move_interactive(cfg, args):
    """Reuse the capture prompt rather than build a picker inside the panel.
    ponytail: free-text prompt; fixed rows (tomorrow/next week/pick) if the
    common cases turn out to be worth a keystroke each."""
    path, lines, i = resolve_ref(cfg, args.ref)
    m = TASK_RE.match(lines[i])
    if m and m.group("status") == MIGRATED:
        return cmd_move(cfg, Args(ref=args.ref, when=""))   # undo, no prompt
    when = run_or_none(["omarchy-menu-input", "Move to", "--width", MENU_WIDTH])
    if not when or not when.strip():
        return
    cmd_move(cfg, Args(ref=args.ref, when=when.strip()))


class Args:
    def __init__(self, **kw):
        self.__dict__.update(kw)


def cmd_list(cfg, args):
    today = date.today()
    if args.dangling:
        rows = dangling(cfg, today)
    elif args.day:
        d = parse_when(args.day)
        rows = tasks_in(cfg, note_path(cfg, d), d) if note_path(cfg, d).exists() else []
    else:
        rows = today_tasks(cfg, today) + dangling(cfg, today)
    # Age lives here, once, so the panel never re-derives the overdue rule.
    for t in rows:
        t["age"] = (today - date.fromisoformat(t["day"])).days
        t["overdue"] = t["age"] > cfg["urgent_days"]
    if args.json:
        print(json.dumps(rows, ensure_ascii=False))
        return
    for t in rows:
        tail = "  %dd%s" % (t["age"], "!" if t["overdue"] else "") if t["age"] > 0 else ""
        print("[%s] %s%s" % (t["status"], t["clean"], tail))


def cmd_log(cfg, args):
    """Read the day's log back. `note` writes one, this reads them."""
    d = parse_when(args.day)
    if d is None:
        sys.exit("bujo: could not read a date from %r" % args.day)
    path = note_path(cfg, d)
    rows = notes_in(cfg, path, d) if path.exists() else []
    if args.json:
        print(json.dumps(rows, ensure_ascii=False))
        return
    for n in rows:
        print("- %s" % n["text"])


def cmd_days(cfg, args):
    """Per-day counts for a month — what the calendar colours its dots from."""
    first, last = month_range(args.month or fmt_date("YYYY-MM", date.today()))
    if first is None:
        sys.exit("bujo: months look like YYYY-MM, got %r" % args.month)
    rows = walk_days(cfg, first, last)
    if args.json:
        print(json.dumps(rows, ensure_ascii=False))
        return
    for r in rows:
        print("%s  %d open  %d done  %d noted" % (r["day"], r["open"], r["done"], r["notes"]))


def cmd_bar(cfg, args):
    today = date.today()
    open_today = len([t for t in today_tasks(cfg, today) if t["status"] == OPEN])
    late = dangling(cfg, today)
    text = "%s %d" % (cfg["icon"], open_today)
    if late:
        text += " · %d" % len(late)
    oldest = min((date.fromisoformat(t["day"]) for t in late), default=None)
    tip = "%d open today" % open_today
    if late:
        tip += "\n%d dangling, oldest %s" % (len(late), fmt_date("D MMM", oldest))
    print(json.dumps({"text": text, "tooltip": tip,
                      "class": "urgent" if late else ""}, ensure_ascii=False))


def cmd_path(cfg, args):
    print(note_path(cfg, parse_when(args.when)))


# The settings page is a client of these three and nothing else. QML never
# opens config.toml — it reads `config get`, asks `config check` whether a
# draft holds up, and hands a change to `config set`.

def setting_value(key, value):
    if key not in DEFAULTS:
        sys.exit("bujo: unknown setting %r (known: %s)" % (key, " ".join(sorted(DEFAULTS))))
    if isinstance(DEFAULTS[key], int):
        try:
            return int(value)
        except ValueError:
            sys.exit("bujo: %s needs a number, got %r" % (key, value))
    return value


def cmd_config_get(cfg, args):
    if args.json:
        print(json.dumps(cfg, ensure_ascii=False))
        return
    for k, v in cfg.items():
        print("%s = %s" % (k, toml_value(v)))


def cmd_config_set(cfg, args):
    cfg[args.key] = setting_value(args.key, args.value)
    write_config(cfg)
    notify_shell()
    print("%s = %s" % (args.key, toml_value(cfg[args.key])))


# Omarchy's own chooser, which talks to the desktop portal. Not a picker of
# ours and not a new dependency: `omarchy-file-select` is already on PATH, and
# a plugin that needs Omarchy 4 can say so.
PICKERS = {
    "vault": ["--directory", "--title", "Obsidian vault"],
    "template_file": ["--title", "Daily note template"],
}


def tildify(path):
    """~ back in, so a picked path reads like one somebody typed."""
    try:
        return "~/%s" % path.relative_to(Path.home())
    except ValueError:
        return str(path)


def cmd_config_pick(cfg, args):
    if args.key not in PICKERS:
        sys.exit("bujo: nothing to pick for %r (try %s)" % (args.key, " or ".join(sorted(PICKERS))))
    picked = run_or_none(["omarchy-file-select"] + PICKERS[args.key])
    if not picked:
        return   # cancelling is an answer
    chosen = Path(picked.splitlines()[0])
    if args.key == "template_file":
        # The setting is vault-relative by definition, so the conversion — and
        # the refusal when it cannot be done — belongs here, not in the dialog.
        vault = vault_path(cfg["vault"])
        try:
            value = str(chosen.relative_to(vault))
        except ValueError:
            sys.exit("bujo: %s is outside the vault (%s)" % (chosen, vault))
    else:
        value = tildify(chosen)
    cmd_config_set(cfg, Args(key=args.key, value=value))


def cmd_config_check(cfg, args):
    # key=value overrides so a draft can be checked before it is saved — the
    # Templater refusal has to reach the user while they are still typing.
    for pair in args.override:
        key, sep, value = pair.partition("=")
        if not sep:
            sys.exit("bujo: overrides look like key=value, got %r" % pair)
        cfg[key] = setting_value(key, value)
    result = check_config(cfg)
    if args.json:
        print(json.dumps(result, ensure_ascii=False))
        return
    for key, field in result["fields"].items():
        if field["note"]:
            print("%s %s: %s" % ("ok " if field["ok"] else "!! ", key, field["note"]))
    if not result["ok"]:
        sys.exit(1)


def notify_shell():
    """The bar polls slowly while its panel is shut, so a capture from the
    palette would otherwise sit unseen for up to a refresh interval. Telling
    the shell directly beats polling harder, and covers every entry point —
    palette, panel and terminal alike. Best-effort: -q keeps this silent when
    no shell is running."""
    try:
        subprocess.run(["omarchy-shell", "-q", "io.github.jonashan.bujo", "refresh"],
                       capture_output=True, timeout=2)
    except (FileNotFoundError, subprocess.TimeoutExpired):
        pass


def run_or_none(cmd):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True)
        return r.stdout.strip() if r.returncode == 0 else None
    except FileNotFoundError:
        return None


# ------------------------------------------------------------------------ main

def main(argv=None):
    import argparse
    p = argparse.ArgumentParser(prog="bujo", description=__doc__.splitlines()[0])
    sub = p.add_subparsers(dest="cmd", required=True)

    a = sub.add_parser("add", help="add a todo, optionally for another day")
    a.add_argument("text")
    a.add_argument("when", nargs="?", default="", help="tomorrow, friday, +3 days, 2026-09-22")
    a.set_defaults(fn=cmd_add)

    sub.add_parser("add-interactive", help="prompt via the omarchy menu").set_defaults(fn=cmd_add_interactive)

    l = sub.add_parser("list", help="today plus everything dangling")
    l.add_argument("--day")
    l.add_argument("--dangling", action="store_true")
    l.add_argument("--json", action="store_true")
    l.set_defaults(fn=cmd_list)

    for name, fn, help_ in (("done", cmd_done, "mark complete"), ("drop", cmd_drop, "mark irrelevant")):
        s = sub.add_parser(name, help=help_)
        s.add_argument("ref")
        s.set_defaults(fn=fn)

    mv = sub.add_parser("move", help="migrate to another day")
    mv.add_argument("ref")
    mv.add_argument("when", nargs="?", default="")
    mv.set_defaults(fn=cmd_move)

    n = sub.add_parser("note", help="append a - bullet to today's log")
    n.add_argument("text")
    n.set_defaults(fn=cmd_note)

    sub.add_parser("note-interactive", help="prompt for a note").set_defaults(fn=cmd_note_interactive)

    e = sub.add_parser("edit", help="rewrite a todo or a note in place")
    e.add_argument("ref")
    e.add_argument("text")
    e.set_defaults(fn=cmd_edit)

    mvi = sub.add_parser("move-interactive", help="prompt for a day, then migrate")
    mvi.add_argument("ref")
    mvi.set_defaults(fn=cmd_move_interactive)

    lg = sub.add_parser("log", help="read a day's ## Log bullets back")
    lg.add_argument("--day", default="")
    lg.add_argument("--json", action="store_true")
    lg.set_defaults(fn=cmd_log)

    dy = sub.add_parser("days", help="per-day counts for a month, for the calendar")
    dy.add_argument("month", nargs="?", default="", help="YYYY-MM, default this month")
    dy.add_argument("--json", action="store_true")
    dy.set_defaults(fn=cmd_days)

    sub.add_parser("bar", help="waybar-style JSON for the omarchy bar").set_defaults(fn=cmd_bar)

    pa = sub.add_parser("path", help="print the note path for a day")
    pa.add_argument("when", nargs="?", default="")
    pa.set_defaults(fn=cmd_path)

    # raw_config: these three have to work when the vault is missing, since
    # fixing that is what the settings page is for.
    c = sub.add_parser("config", help="read, write and check the settings")
    csub = c.add_subparsers(dest="action", required=True)

    cg = csub.add_parser("get", help="print the effective settings")
    cg.add_argument("--json", action="store_true")
    cg.set_defaults(fn=cmd_config_get, raw_config=True)

    cs = csub.add_parser("set", help="change one setting")
    cs.add_argument("key")
    cs.add_argument("value")
    cs.set_defaults(fn=cmd_config_set, raw_config=True)

    cp = csub.add_parser("pick", help="choose a vault or template file in the desktop chooser")
    cp.add_argument("key", choices=sorted(PICKERS))
    cp.set_defaults(fn=cmd_config_pick, raw_config=True)

    cc = csub.add_parser("check", help="verdict per setting; key=value tries a draft")
    cc.add_argument("override", nargs="*")
    cc.add_argument("--json", action="store_true")
    cc.set_defaults(fn=cmd_config_check, raw_config=True)

    args = p.parse_args(argv)
    args.fn(read_config() if getattr(args, "raw_config", False) else load_config(), args)


if __name__ == "__main__":
    main()
