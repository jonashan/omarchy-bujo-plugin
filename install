#!/usr/bin/env bash
# Install bujo: the CLI on PATH, the plugin into omarchy.
# The plugin dir must hold real files — omarchy-plugin-validate refuses
# symlinks inside a plugin folder — so the QML is copied, not linked.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
dest="$HOME/.config/omarchy/plugins/jsc.bujo"

mkdir -p "$HOME/.local/bin" "$dest"
ln -sfn "$here/bujo" "$HOME/.local/bin/bujo"
cp "$here"/plugin/*.qml "$here"/plugin/manifest.json "$dest/"

omarchy-plugin-validate "$dest"
omarchy-plugin-enable jsc.bujo 2>/dev/null || true

# The running shell keeps the QML it started with. "Local plugin changed,
# reloading" in the log is the plugin registry, not the live widgets — copying
# new files over them changes nothing until the shell restarts, which is a
# tidy way to spend an afternoon testing a fix that was never loaded.
omarchy-restart-shell

echo "installed — add {\"id\": \"jsc.bujo\"} to bar.layout in ~/.config/omarchy/shell.json"
