<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap">
  <style>
    body { margin: 0; font-family: "JetBrains Mono", ui-monospace, "DejaVu Sans Mono", monospace; }
    a { color: #1e66f5; } a:hover { color: #1a56d0; }
    .ground { display: flex; align-items: flex-start; justify-content: center;
              padding: 24px; background: #dce0e8; min-height: 100%; box-sizing: border-box; }
    .card { width: 360px; padding: 14px; background: #eff1f5; border: 2px solid #1e66f5;
            border-radius: 8px; box-sizing: content-box; }
    .col { display: flex; flex-direction: column; gap: 8px; width: 360px; }
    .hdr { display: flex; align-items: center; gap: 8px; height: 22px; }
    .ttl { font-size: 12px; font-weight: 700; color: #4c4f69; }
    .sep { height: 1px; background: rgba(76,79,105,0.12); }
    .sect { display: flex; align-items: baseline; justify-content: space-between;
            font-size: 10px; font-weight: 700; color: #36384b; padding-top: 2px; }
    .rows { display: flex; flex-direction: column; }
    .row { display: flex; align-items: center; gap: 9px; height: 24px; }
    .lbl { flex: 1; font-size: 12px; color: #4c4f69; min-width: 0;
           overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .age { font-size: 10px; color: rgba(76,79,105,0.38); }
    .dim { color: rgba(76,79,105,0.38); }
    .on { color: #1e66f5; }
    .cut { text-decoration: line-through; }
    .cur { background: rgba(76,79,105,0.08); }
    .legend { display: flex; flex-wrap: wrap; gap: 11px; font-size: 10px;
              color: rgba(76,79,105,0.38); }
    .k { color: #36384b; }
    .note { font-size: 12px; color: #4c4f69; flex: 1; }
    .dot { width: 14px; display: flex; justify-content: center;
           font-size: 12px; color: rgba(76,79,105,0.38); }
  </style>
</helmet>
